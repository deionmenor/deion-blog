---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getTopics } from '../../lib/posts';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const count = topic.posts.length;
---

<Base
  title={`${topic.label} — Topics`}
  description={`${count} ${count === 1 ? 'entry' : 'entries'} about ${topic.label} on Deion Menor's site.`}
>
  <header class="page-header">
    <p class="eyebrow">
      <a href={href('/topics/')}>Topics</a> / {topic.label}
    </p>
    <h1>{topic.label}</h1>
    <p class="page-intro">
      {count} {count === 1 ? 'entry' : 'entries'} about this topic.
    </p>
  </header>

  <PostList posts={topic.posts} />
</Base>
