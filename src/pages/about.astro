---
import Base from '../layouts/Base.astro';
import { SITE, href } from '../lib/site';

const links = SITE.links.map((link) => ({
  ...link,
  href: link.href.startsWith('/') ? href(link.href) : link.href,
}));
---

<Base
  title="About"
  description="About Deion Menor — software engineer, technical consultant, and product designer."
  current="about"
>
  <header class="page-header">
    <p class="eyebrow">About</p>
    <h1>About me</h1>
    <div class="prose">
      <p>
        I'm Deion Menor, a software engineer who is in love with all forms of
        physical media. After earning a living building internal software for an e-commerce platform, during the height of the pandemic, I helped found an{' '}
        <a href="https://www.nocode.ph/" rel="noopener noreferrer" target="_blank">initiative</a>{' '}
        to empower non-technical citizens to get into tech themselves through no-code and
        low-code tools.
      </p>
      <p>
        Now, I'm helping other non-technical founders launch products as both a
        technical consultant and product designer.
      </p>
    </div>
  </header>

  <div class="prose">
    <h2>Elsewhere</h2>
    <p>
      The best way to reach me is through my{' '}
      <a href="mailto:deionmenor@gmail.com?subject=I'd%20like%20to%20connect%20with%20you!">email</a>.
    </p>
    <p>You can also follow me at the following places:</p>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              target={link.href.startsWith('http') ? '_blank' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2>Colophon</h2>
    <p>
      Built with{' '}
      <a href="https://astro.build/" rel="noopener noreferrer" target="_blank">Astro</a>{' '}
      and deployed on GitHub Pages. Set in a system serif, with a mono for
      metadata. The palette is derived from{' '}
      <a href="https://github.com/kepano/flexoki" rel="noopener noreferrer" target="_blank">Flexoki</a>{' '}
      (MIT).
    </p>
  </div>
</Base>
