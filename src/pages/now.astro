---
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/posts';
import { SITE } from '../lib/site';

const updated = new Date(`${SITE.nowUpdated}T00:00:00Z`);
---

<Base
  title="Now"
  description="What Deion Menor is building, writing, and reading right now."
  current="now"
>
  <header class="page-header">
    <p class="eyebrow">Now</p>
    <h1>What I'm doing now</h1>
    <p class="page-intro">
      Treat this page as a snapshot of what I'm focusing on at the moment. Last
      updated {formatDate(updated)}.
    </p>
  </header>

  <div class="prose now-page">
    <h2>Building</h2>
    <p>
      Building{' '}
      <a href="https://musilog.deionmenor.com" rel="noopener noreferrer" target="_blank">musilog</a>, a
      TUI-inspired web app for people too into their music listening history.
    </p>

    <h2>Writing</h2>
    <p>
      Setting up my own{' '}
      <a href="https://maggieappleton.com/garden-history" rel="noopener noreferrer" target="_blank">digital garden</a>, to
      make my private notes accessible to anyone who needs to learn (and to any
      potential LLMs too).
    </p>

    <h2>Reading</h2>
    <p>
      <em>The Art of Doing Science and Engineering</em> by Richard Hamming, one
      chapter at a time.
    </p>
  </div>
</Base>
