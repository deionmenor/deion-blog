---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, readingTime } from '../../lib/posts';
import { href } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const posts = await getPosts();
const index = posts.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;

const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  current="writing"
  type="article"
>
  <article>
    <header class="post-header">
      <p class="eyebrow">
        <a href={href('/writing/')}>Writing</a>
      </p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="dot" aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a class="back-link" href={href('/writing/')}>← All writing</a>

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="More writing">
            {newer ? (
              <a href={href(`/writing/${newer.id}/`)}>
                <span class="post-nav-label">Newer</span>
                <span class="post-nav-title">{newer.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {older ? (
              <a class="next" href={href(`/writing/${older.id}/`)}>
                <span class="post-nav-label">Older</span>
                <span class="post-nav-title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </footer>
  </article>
</Base>
